</span></span><span style="background-color:transparent"><span>  </span><span class="token literal-property" style="color:hsl(355, 65%, 65%)">webhookUrl</span><span class="token" style="color:hsl(207, 82%, 66%)">:</span><span> </span><span class="token" style="color:hsl(95, 38%, 62%)">&quot;https://optional.webhook.url/for/results&quot;</span><span class="token" style="color:hsl(220, 14%, 71%)">,</span><span>
